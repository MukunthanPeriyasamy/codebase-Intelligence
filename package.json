{
  "name": "codebase-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Internal, commit-grounded repository intelligence desktop",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && npm start",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.6.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
